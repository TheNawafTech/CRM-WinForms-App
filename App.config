<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Default development setup: local default SQL Server instance with Windows authentication.
         Change Server/Database here (or in CRM.exe.config next to the built executable); no rebuild is needed. -->
    <add name="CRMproject"
         connectionString="Server=.;Database=CRMproject;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
